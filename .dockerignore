# Keeps the Docker build context small and the image reproducible — never
# ship local node_modules/dist/.env into the build (they get reinstalled/
# rebuilt inside the image from package-lock.json, which is the whole point).
**/node_modules
**/dist
**/.next
**/.git
**/*.log
**/.env
**/.env.local
# Runtime document storage only (backend/storage). A bare **/storage also matched
# source directories (backend/src/infrastructure/storage, frontend/app/dashboard/storage),
# which broke the image build.
backend/storage
backups
backend/test-results.json
backend/coverage

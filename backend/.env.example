DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=DMS

# scripts/migrate.ts only (never read by the app). Real production
# (docker-compose.prod.yml) runs its `migrate` one-shot as the postgres
# superuser and only the API/worker connect as DB_USER/edams_app — see
# Documentations/DEPLOY-COMPOSE.md. A local (non-Docker) mirror or manual
# production setup has no such split: DB_USER alone runs both the app and
# `npm run db:migrate[:mirror|:prod]`, so if that role doesn't already own
# every table, any migration that ALTERs an existing one fails with "must be
# owner of table X" (hit 2026-09-21 on a fresh local mirror). Set these to a
# superuser credential to restore the Docker-style split without touching
# DB_USER/DB_PASSWORD above. Leave unset when DB_USER is already postgres
# (dev) — falls back to DB_USER/DB_PASSWORD automatically.
#DB_MIGRATE_USER=postgres
#DB_MIGRATE_PASSWORD=your_postgres_superuser_password

# DATA-4: required in production/mirror ONLY — scripts/db-backup.ts's pg_dump
# runs as DB_USER above, and migration 20260822000004-rls-force.sql makes
# every table's RLS apply even to its OWNER (edams_app owns every table in
# dmsprod). Without a role that BYPASSES RLS, pg_dump refuses the dump
# outright rather than writing a silently-incomplete backup — which sounds
# safe until the nightly backup job has been failing for months with nobody
# watching its output (exactly what happened with the __dirname ES-module
# bug this same script's own header documents; see SERVER-DEPLOYMENT-TODO.md
# §1). Point these at a role created specifically for backups, granted
# BYPASSRLS — never grant BYPASSRLS to DB_USER/edams_app itself, which is the
# live application's own role and would disable tenant isolation for every
# request DMS serves just to fix a nightly batch job. Unset in development —
# RLS is not force-enabled there, so DB_USER/DB_PASSWORD already work for a dump.
#BACKUP_DB_USER=dms_backup
#BACKUP_DB_PASSWORD=change-this-and-store-it-with-your-other-production-secrets

# Advanced / rare: only needed if your host injects DATABASE_URL directly
# (Railway/Render/Heroku-style) instead of the DB_* vars above. In
# production/staging, an explicit DATABASE_URL is refused at boot unless
# DATABASE_URL_TRUSTED=true is also set — this stops a stray leftover
# DATABASE_URL from an unrelated project being silently trusted just
# because its credentials happen to look valid.
#DATABASE_URL=
#DATABASE_URL_TRUSTED=true

# Audit HMAC
AUDIT_HMAC_SECRET=change-this-to-a-32-character-minimum-secret-key-here

# How many independent hash chains each tenant's audit trail is split across.
# writeAuditLog holds a per-chain advisory XACT lock from a request's first
# audit write until that request commits (at response-finish), so with one
# chain per tenant every mutating request in a tenant queues behind the one in
# front of it. Sharding raises that ceiling without weakening the guarantee
# that each audit row commits atomically with the change it records.
# Safe to change at any time: shards are assigned randomly per write, so
# existing rows keep their chain and only new rows are redistributed.
# 1 reproduces the old single-chain behaviour. Default 8.
AUDIT_CHAIN_SHARDS=8

# Redis
# 127.0.0.1 — see the MINIO_ENDPOINT note below. Redis fails the same way over
# "localhost" on Docker Desktop (ioredis connects over ::1, the connection is
# reset, and the client sits in a reconnect loop). The consequence was quiet
# and wide: no BullMQ workers, no socket.io Redis adapter (realtime becomes
# local-only), every cache read a miss, and rate limiting permanently on the
# in-memory fallback R-03 added for Redis OUTAGES — in dev that fallback was
# the normal path, not the exception.
REDIS_URL=redis://127.0.0.1:6379

# MinIO
# 127.0.0.1, not "localhost", and the distinction is not cosmetic.
#
# Node resolves "localhost" with DNS order "verbatim" (the default since Node
# 17), which on Windows puts ::1 ahead of 127.0.0.1. Docker Desktop binds
# [::]:9000 and ACCEPTS the IPv6 connection, then resets it — so an HTTP client
# gets ECONNRESET rather than the ECONNREFUSED that would let it fall back to
# IPv4. A raw TCP connect still succeeds (Node's autoSelectFamily retries), so
# a port check looks fine while every real request fails.
#
# Effect, before this was pinned: the health endpoint reported MinIO and
# Meilisearch as "error" on a dev box where both containers were up and
# reachable by curl, and the app silently ran on its local-disk storage and
# PostgreSQL-ILIKE search fallbacks. Both fallbacks work, which is exactly why
# nobody noticed — dev was not exercising the real storage or search path at
# all. Verified with test-scripts/verify-load-safety.ts.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_DOCUMENTS=dms-documents
MINIO_BUCKET_ARCHIVE=dms-archive

# Meilisearch
# 127.0.0.1 for the same reason as MINIO_ENDPOINT above. Host port is 9700,
# not meilisearch's default 7700 -- see docker-compose.dev.yml's meilisearch
# comment (7700 sits inside a Windows excluded TCP port range).
MEILISEARCH_HOST=http://127.0.0.1:9700
MEILISEARCH_MASTER_KEY=masterKey

# Outbound email (SMTP)
# 127.0.0.1 — see the MINIO_ENDPOINT note above (MailHog is a container too).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DMS System <noreply@edams.local>
# Dev only. Redirect every outbound email to one address (real recipients are
# kept in the subject/body). Refused at boot in production/staging.
# EMAIL_REDIRECT_TO=you@example.com

# Admin alerting for unhandled server faults (shared/middleware.ts's
# ERR-INTERNAL catch-all, "The team has been notified"). Both optional and
# independent; set either or both. Without at least one set, that response
# text is not backed by anything but a local log line — a warning is printed
# at boot in production/mirror if neither is configured. Verify from the app:
# Operations -> System Errors has a "Send test alert" button.
# Point ADMIN_ALERT_WEBHOOK_URL at the SAME Slack webhook as the platform's
# uptime-monitor.ps1 (its EXAMPLECORP_ALERT_WEBHOOK) to land both outage and
# application-fault alerts in one channel.
#ADMIN_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
#ADMIN_ALERT_EMAIL_TO=ops@examplecorp.com,dev-team@examplecorp.com
# Dedupe window (ms) per route+error-type — one alert per window instead of
# one per request while a fault is repeating. Default 600000 (10 minutes).
#ADMIN_ALERT_THROTTLE_MS=600000

# Antivirus (ClamAV) — used by every upload/attachment/signature-image scan path.
# Leave this ON and run clamd. With it off, scanBuffer() returns "clean" without
# scanning, so uploads are audited as DOCUMENT_SCAN_CLEAN having never been
# checked. Uploads are not blocked when clamd is down (documented fail-open
# policy) — they are recorded 'unscanned', and the backend says so once at boot.
CLAMAV_ENABLED=true
# false (default) = if clamd is unreachable, accept the upload and flag it unscanned. true = refuse the upload (503) instead.
CLAMAV_FAIL_CLOSED=false
# How long an undelivered EMAIL outbox event stays deliverable (hours, default
# 72). This bounds a flood, it does not suppress mail: an approval request is
# still worth sending tomorrow, but relaying a two-month backlog the moment SMTP
# recovers is its own incident — it got the shared Gmail relay temporarily
# blocked once. WEBSOCKET events expire after 1h and OCR/SEARCH_INDEX never
# expire at all; see CHANNEL_MAX_AGE_HOURS in infrastructure/queue/outbox.ts.
#OUTBOX_EMAIL_MAX_AGE_HOURS=72
# 127.0.0.1 — see the MINIO_ENDPOINT note above. Over "localhost" the daemon
# handshake is reset, scanBuffer() takes its documented fail-open-but-flagged
# path, and every dev upload is recorded "unscanned" — so the real scan path
# was never exercised locally.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Feature flags
# Queue workers run in their own process (npm run dev starts both the API
# and the worker together — see package.json's dev/dev:api/dev:worker), so
# this stays false for the API process; a crash in worker code (native
# OCR/PDF-rasterization crash, etc.) then can't take the live API server
# down with it. Matches docker-compose.prod.yml's API-vs-worker service split.
ENABLE_QUEUE_WORKERS=false
ENABLE_OUTBOX_POLLING=true
# Approval engine: step delegation and automatic escalation of overdue steps (defaults shown).
# Escalation adds the department head(s), else approval admins, as co-deciders after the grace period.
APPROVAL_DELEGATION_ENABLED=true
APPROVAL_ESCALATION_ENABLED=true
APPROVAL_ESCALATION_GRACE_HOURS=24
APPROVAL_ESCALATION_MAX_TARGETS=3
# Letters: default deadline in hours for a review/approval step (0 = none; the drafter may set one per step).
LETTER_STEP_DEFAULT_SLA_HOURS=0
ENABLE_API_DOCS=true            # must be false in production/staging (disables CSP, serves unauthenticated Swagger UI)
ENABLE_PUBLIC_METRICS_ROUTE=false

# Business hours (used by SLA/reminder scheduling)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17

# Frontend origin / CORS
CLIENT_URL=http://localhost:7101
CORS_ORIGINS=                    # optional comma-separated allowlist; defaults to [CLIENT_URL]

# Internal service-to-service API key (SSO -> DMS internal routes)
DMS_INTERNAL_API_KEY=

# OIDC / SSO login (optional — omit to disable SSO login flow)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# SSO P1-2: the role/group claims moved out of the `profile` scope into their
# own (`ad_groups`, `edams_roles`). Requesting only "openid profile email" now
# yields an id_token with no roles and no AD groups, which silently flattens
# every first-time SSO user to EMPLOYEE. Must stay a subset of the `edams`
# client scope seeded in SSO/backend/src/config.ts.
OIDC_SCOPES=openid profile email ad_groups edams_roles
OIDC_TOKEN_ENDPOINT=              # falls back to AUTH_ISSUER + /token when omitted

# CAMS (correspondence) QR verification base URL
CAMS_VERIFY_BASE_URL=http://localhost:7101/verify
# First segment of letter and form reference numbers (PREFIX/UNIT/DEPT/TYPE/YEAR/SEQ); 1-8 upper-case letters or digits.
REFERENCE_NUMBER_PREFIX=REF

# PAdES e-signature flattened copies — generate a self-signed cert with
# scripts/generate-esign-cert.js, or provision a real org certificate
ESIGN_P12_B64=
ESIGN_P12_PASSPHRASE=

# Auth - SPRINT-1
# LOCAL_JWT_MOCK=false: no passwordless /auth/login, everyone signs in through SSO. Turning it off is safe:
# DMS verifies its OWN session tokens (kid 'dev-key', DEV_RSA_* below) whether or not this is on
# (shared/auth.ts). Set to true ONLY on a developer machine to sign in as a seeded demo account
# without a running SSO (needed by test-scripts/verify-*.ts). Never in production or mirror.
LOCAL_JWT_MOCK=false
DEV_JWT_ISSUER=http://localhost:7300
DEV_JWT_AUDIENCE=edams-api
AUTH_ISSUER=                    # real external issuer — empty until provider ready
AUTH_AUDIENCE=                  # real external audience — empty until provider ready
AUTH_JWKS_URI=                  # JWKS endpoint — empty until provider ready
DEV_RSA_PRIVATE_KEY=            # base64-encoded RSA private key for mock
DEV_RSA_PUBLIC_KEY=             # base64-encoded RSA public key for mock
SEARCH_ENGINE=postgres          # or meilisearch

# Storage - SPRINT-4
STORAGE_DRIVER=local            # local or minio (S4-02)
# Absolute path to the local document store. Default: <cwd>/storage/dms-documents.
# Set it explicitly in any deployment started by a script — cwd depends on the
# launcher, and a wrong cwd silently creates a new empty store rather than
# failing. Point it at a second disk when the system drive gets tight; copy the
# existing directory across and verify before repointing.
# STORAGE_LOCAL_PATH=D:/dms-storage/dms-documents

# Key management (document encryption KEKs)
# VAULT_BACKEND selects the backend: dev | env | hashicorp.
#   dev       — dev/test only; production refuses to boot with it.
#   env       — production env-key backend: same wrapping scheme, master keys
#               injected as secrets. Set VAULT_MASTER_KEY (>=32 chars, NOT the
#               dev placeholder). Rotate by setting VAULT_MASTER_KEY_V2 +
#               DEV_VAULT_MASTER_KEY_CURRENT_VERSION=2, then running
#               scripts/rewrap-deks.ts --execute.
#   hashicorp — HashiCorp Vault Transit engine; requires VAULT_ADDR and
#               VAULT_TOKEN (optional: VAULT_NAMESPACE, VAULT_TRANSIT_MOUNT,
#               VAULT_TRANSIT_KEY_PREFIX).
# Legacy: DEV_VAULT_MOCK=true (below) implies VAULT_BACKEND=dev when unset.
VAULT_BACKEND=dev
DEV_VAULT_MOCK=true
DEV_VAULT_MASTER_KEY=dms-dev-vault-key-32bytes!!  # dev only — prod uses VAULT_MASTER_KEY
#VAULT_MASTER_KEY=              # production (VAULT_BACKEND=env): >=32 chars, generate with `openssl rand -base64 48`
#VAULT_ADDR=                    # production (VAULT_BACKEND=hashicorp)
#VAULT_TOKEN=                   # production (VAULT_BACKEND=hashicorp)

# AI Assistant (chat + document summarization/metadata extraction) — vendor
# neutral, see backend/src/modules/ai/llmClient.ts. Set the key(s) for
# whichever provider you have; auto-detected in this order unless AI_PROVIDER
# forces one explicitly (groq | openai | anthropic | custom):
#   1. groq      — GROQ_API_KEY        (api.groq.com, OpenAI-compatible)
#   2. openai    — OPENAI_API_KEY      (api.openai.com, or OPENAI_BASE_URL for a proxy/Azure front)
#   3. custom    — AI_BASE_URL + AI_API_KEY  (any other OpenAI-compatible endpoint:
#                  OpenRouter, Together, Fireworks, a local Ollama/vLLM server, ...)
#   4. anthropic — AI_API_KEY or ANTHROPIC_API_KEY (native Messages API — only
#                  reached when AI_BASE_URL is unset, since AI_API_KEY alone has
#                  always meant "Anthropic" here)
#AI_PROVIDER=
#GROQ_API_KEY=
#GROQ_MODEL=openai/gpt-oss-120b
#GROQ_VISION_MODEL=qwen/qwen3.8-27b
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=
#AI_BASE_URL=
#AI_API_KEY=
#AI_MODEL=gpt-4o-mini
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-6

# P1-10: source addresses allowed to reach this system's INTERNAL service-to-service
# API, checked BEFORE the shared key is compared. Every real caller is another
# Example Corp backend on this same host, so loopback-only matches the actual
# topology and removes remote brute-forcing of the static key entirely.
# Comma-separated. "*" disables the check -- never in production.
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# How many reverse-proxy hops in front of this process may set
# X-Forwarded-For. Passed straight to Express's `trust proxy` setting.
#
# Leave at the `loopback` default in every environment fronted by the shared
# Apache proxy (i.e. production: 7100 is loopback-only and Apache is the only
# way in). Express defaults this OFF, which made req.ip the proxy's own
# address for every user in the organisation — collapsing the per-IP rate
# limits (/api/v1/auth is 20/min, /api is 800/min) into one shared
# organisation-wide budget, and recording the proxy instead of the client in
# audit_logs.source_ip.
#
# Never set this to `true`. That trusts every hop, which hands req.ip to the
# caller and lets any client bypass those per-IP limits by rotating a header.
# Use `loopback`, `false`, a hop count (1), or a comma-separated
# address/CIDR list.
TRUST_PROXY=loopback

# ── Load safety (R-01) ───────────────────────────────────────────────────────
# tenantContext holds one pooled DB connection for the whole lifetime of every
# authenticated request, so DB_POOL_MAX is the real concurrency ceiling.
# Defaults are in backend/src/config/env.ts with the full reasoning.
#
# DB_POOL_MAX=60
# DB_POOL_ACQUIRE_MS=30000
#
# Caps how long one request may hold the connection it checked out. Applied as
# SET LOCAL inside the request transaction, so migrations, workers and backfill
# scripts are unaffected. Keep the idle-in-transaction cap comfortably above
# the slowest in-request non-DB I/O (ClamAV scan, PDF render, MinIO upload) or
# it will abort healthy uploads.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=120000
#
# Max authenticated requests in flight before further ones are shed with 503 +
# Retry-After instead of queueing for DB_POOL_ACQUIRE_MS and then failing.
# 0 = derive as DB_POOL_MAX * 2.
# REQUEST_ADMISSION_MAX=0

# Per-user request budget for the authenticated v1 API, per minute (default 100).
# Raise it ONLY for an end-to-end run: the browser and the Playwright suite share
# one user's budget, and 30 page-driving tests legitimately exceed what a human
# generates. Leave it at the default in production — this is the cap that stops
# one caller consuming the shared concurrency allowance.
# RATE_LIMIT_USER_PER_MINUTE=1000

# ── Platform licensing (docs/operations/PLATFORM-LICENSING.md at the repo root; DMS is system key "dms") ──
# The licence is issued and managed in SSO; DMS fetches a signed token and enforces it. Every setting is optional.
# With no licence record in SSO, or SSO unreachable and no token ever fetched, NOTHING is enforced.
#   enforce (default) read-only once a verified licence has expired (after warn + grace), module gate, seat limit
#   warn              the same states are computed and shown (banner, GET /license/status) but nothing is blocked
#   off               no fetcher, no enforcement
# Emergency switch: LICENSE_ENFORCEMENT=warn, restart the API.
# LICENSE_ENFORCEMENT=enforce
# SSO BACKEND base URL (no path). Loopback on the shared server: 7300 dev, 9300 mirror, 7300 live.
# LICENSE_SSO_URL=http://127.0.0.1:7300
# LICENSE_POLL_SECONDS=300
# Where the last verified token is kept (so a restart while SSO is down still enforces it).
# Default: <backend>/.license/dms-<NODE_ENV>.json (git-ignored).
# LICENSE_CACHE_PATH=

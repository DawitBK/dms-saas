{
  "name": "@dms/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WORKER -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "predev:api": "node scripts/free-dev-port.cjs main",
    "dev:api": "nodemon --watch src --ext ts,js,json --exec tsx src/main.ts",
    "predev:worker": "node scripts/free-dev-port.cjs worker",
    "dev:worker": "nodemon --watch src --ext ts,js,json --exec tsx src/bin/worker.ts",
    "start": "node dist/src/main.js",
    "start:prod": "node scripts/run-with-env.cjs production node dist/src/main.js",
    "start:mirror": "node scripts/run-with-env.cjs mirror node dist/src/main.js",
    "env:verify:prod": "node scripts/run-with-env.cjs production tsx scripts/verify-prod-env.ts",
    "env:verify:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/verify-prod-env.ts",
    "worker": "tsx src/bin/worker.ts",
    "worker:prod": "node scripts/run-with-env.cjs production tsx src/bin/worker.ts",
    "worker:mirror": "node scripts/run-with-env.cjs mirror tsx src/bin/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests --json --outputFile=test-results.json",
    "test:coverage": "jest --passWithNoTests --json --outputFile=test-results.json --coverage --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=lcov",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:prod": "node scripts/run-with-env.cjs production tsx scripts/migrate.ts up",
    "db:migrate:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/migrate.ts up",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "report:classified": "tsx scripts/report-classified-documents.ts",
    "report:classified:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/report-classified-documents.ts",
    "report:classified:prod": "node scripts/run-with-env.cjs production tsx scripts/report-classified-documents.ts",
    "db:migrate:check": "tsx scripts/check-migration-safety.ts",
    "parity:check": "tsx scripts/check-validator-limits.ts",
    "db:cleanup:test-structure": "tsx scripts/cleanup-test-structure.ts",
    "db:seed": "npm run db:seed:core",
    "db:seed:core": "tsx scripts/seed-core.ts",
    "db:seed:qa": "tsx scripts/seed-qa-world.ts",
    "db:seed:core:prod": "node scripts/run-with-env.cjs production tsx scripts/seed-core.ts",
    "db:seed:core:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/seed-core.ts",
    "db:seed:reference": "tsx scripts/seed-reference-data.ts",
    "db:seed:reference:prod": "node scripts/run-with-env.cjs production tsx scripts/seed-reference-data.ts",
    "db:seed:reference:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/seed-reference-data.ts",
    "db:seed:reset": "tsx scripts/seed-reset.ts && npm run db:seed:core",
    "db:setup": "npm run db:migrate && npm run db:seed:core",
    "sync:dev-to-mirror": "tsx scripts/sync-dev-to-mirror.ts --from=.env --to=.env.mirror",
    "reconcile-storage": "tsx scripts/reconcile-storage-usage.ts",
    "sweep:orphaned-storage": "tsx scripts/sweep-orphaned-storage.ts",
    "backfill-plaintext-hash": "tsx scripts/backfill-plaintext-hash.ts",
    "roles:backfill": "tsx scripts/backfill-role-permission-overrides.ts",
    "roles:backfill:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/backfill-role-permission-overrides.ts",
    "roles:backfill:prod": "node scripts/run-with-env.cjs production tsx scripts/backfill-role-permission-overrides.ts",
    "roles:reset-default": "tsx scripts/reset-role-permissions-to-default.ts",
    "roles:reset-default:mirror": "node scripts/run-with-env.cjs mirror tsx scripts/reset-role-permissions-to-default.ts",
    "roles:reset-default:prod": "node scripts/run-with-env.cjs production tsx scripts/reset-role-permissions-to-default.ts",
    "find-orphaned-folders": "tsx scripts/find-orphaned-folders.ts",
    "rewrap-deks": "tsx scripts/rewrap-deks.ts",
    "db:backup": "tsx scripts/db-backup.ts development",
    "db:backup:prod": "node scripts/run-with-env.cjs production tsx scripts/db-backup.ts production",
    "storage:backup": "tsx scripts/storage-backup.ts development",
    "storage:backup:prod": "node scripts/run-with-env.cjs production tsx scripts/storage-backup.ts production",
    "verify:all": "tsx test-scripts/run-all-verifications.ts",
    "verify:phase1": "tsx test-scripts/verify-phase1-permissions.ts",
    "verify:phase2": "tsx test-scripts/verify-phase2-tenancy.ts",
    "verify:phase3": "tsx test-scripts/verify-phase3-hierarchy.ts",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfme/common": "^6.1.11",
    "@pdfme/generator": "^6.1.11",
    "@pdfme/schemas": "^6.1.11",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tus/file-store": "^2.1.0",
    "@tus/server": "^2.4.1",
    "bullmq": "^5.78.0",
    "canvas": "^3.2.3",
    "clamscan": "^2.4.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.1.1",
    "franc": "^6.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "meilisearch": "^0.45.0",
    "minio": "^8.0.7",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.0",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.5",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.1.1",
    "umzug": "^3.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/clamscan": "^2.4.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "axios": "^1.18.1",
    "eslint": "^10.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

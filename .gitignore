# Runtime document storage (user-uploaded encrypted blobs — not source)
backend/storage/
backend/storage-mirror/

# Platform licensing: the last verified licence token (per environment), written at runtime
backend/.license/

# Claude Code local tooling config
.claude/

# TypeScript incremental build artifacts
*.tsbuildinfo
**/test-results.json

# tesseract.js downloads its OCR language model to CWD on first use
backend/*.traineddata

# Redis snapshot — written to CWD by whichever redis-server process is
# running locally (e.g. a dev-environment WSL instance), not source
*.rdb
e2e/.auth/

# Playwright
test-results/
playwright-report/

# Backups: pg_dump output and a full mirror of the document store.
# Never committable — this is the corpus itself, plus decryptable metadata.
backups/

# Next 16 scaffolding: generated in the app dir on every `next dev`, and the
# The generated notes file next to AGENTS.md only contains "@AGENTS.md". Not repo docs.
/frontend/AGENTS.md
/frontend/CLAUDE.md
e2e/qa-shots/

# The company directory exported for name matching (names and work addresses of staff): never committed.
Collected-Data/.sso-directory.json

# Office lock files (an open Excel/Word document)
~$*

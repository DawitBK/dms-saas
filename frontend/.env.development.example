# Development values. Copy to .env.development (NOT .env.local — Next loads
# .env.local in production builds too, where it outranks .env.production).
NEXT_PUBLIC_API_BASE_URL=http://localhost:7100/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:7100

# Path prefix the app is served under. UNSET in development (DMS owns the root
# of localhost:7101). In production it is /dms, because the shared Apache proxy
# serves DMS below https://portal.examplecorp.com/dms. Next bakes this into every
# link and static asset at BUILD time, so it must be set before `npm run build`,
# not at start time.
# NEXT_PUBLIC_BASE_PATH=/dms

# Socket.IO mount path. Normally leave this UNSET — it is derived from
# NEXT_PUBLIC_BASE_PATH (`${BASE_PATH}/socket.io`) so it cannot drift from the
# path the app is served under.
#
# It matters because Socket.IO treats a path in the connection URL as a
# NAMESPACE, not a path prefix, so NEXT_PUBLIC_SOCKET_URL must stay an origin
# and the path has to be passed separately. On the shared reverse proxy an
# unprefixed /socket.io/ belongs to GMS; DMS is at /dms/socket.io/. Getting
# this wrong points every browser's realtime connection at a sibling system,
# which fails silently and leaves the UI on its fallback polls.
# NEXT_PUBLIC_SOCKET_PATH=/dms/socket.io

# Show the passwordless dev login and demo-account list on /login (dev machines only; never in mirror or production).
NEXT_PUBLIC_DEV_LOGIN=true

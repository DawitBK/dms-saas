# EDAMS production environment — template for the server-side .env.prod used
# by docker-compose.prod.yml. Copy to .env.prod, fill EVERY value, never
# commit the filled file (.env.* is gitignored). The backend's boot guards
# refuse to start if dev defaults leak through (see config/env.ts
# assertProductionRuntimeRequirements).
#
# Generate strong secrets with:  openssl rand -base64 48

# ── Domains & TLS ────────────────────────────────────────────────────────────
# Apache on the shared portal server owns TLS and routes /dms to this stack.
PUBLIC_ORIGIN=https://portal.examplecorp.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=dmsprod
# Superuser: container init + migrations + backups ONLY. Never the app.
POSTGRES_PASSWORD=change-me-prod-password
# Least-privilege role the API/worker connect as (RLS enforced).
EDAMS_APP_DB_PASSWORD=change-me-prod-password

# ── Auth ─────────────────────────────────────────────────────────────────────
# RS256 keypair (base64-encoded PEMs) — generate with:
#   node backend/scripts/generate-rsa-keys.js
RSA_PRIVATE_KEY_B64=
RSA_PUBLIC_KEY_B64=
# Issuer/audience stamped into and verified on every token. For self-issued
# JWTs point the issuer at the API itself; for the Example Corp IdP use its URL.
AUTH_ISSUER=https://portal.examplecorp.com/sso
AUTH_AUDIENCE=edams-api
# Only needed when tokens are verified against an external IdP's JWKS:
AUTH_JWKS_URI=https://portal.examplecorp.com/sso/jwks
OIDC_CLIENT_ID=edams
OIDC_CLIENT_SECRET=must-match-SSO-EDAMS_CLIENT_SECRET
OIDC_REDIRECT_URI=https://portal.examplecorp.com/dms/auth/callback
OIDC_TOKEN_ENDPOINT=https://portal.examplecorp.com/sso/token
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Audit chain ──────────────────────────────────────────────────────────────
AUDIT_HMAC_SECRET=

# ── IdP internal admin API ───────────────────────────────────────────────────
# Shared secret the IdP's admin console uses to manage DMS role permissions and
# per-user permission overrides (see src/shared/internalAuth.ts). Unset = the
# /api/v1/internal/roles/* routes always refuse. Must match the IdP's own
# DMS_INTERNAL_API_KEY.
DMS_INTERNAL_API_KEY=

# ── Document encryption (KEK backend) ────────────────────────────────────────
# env: master keys as secrets (default). hashicorp: Vault Transit.
VAULT_BACKEND=env
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_CURRENT_VERSION=1
# Only for VAULT_BACKEND=hashicorp:
VAULT_ADDR=
VAULT_TOKEN=

# ── E-sign PAdES flattened copies ────────────────────────────────────────────
# PKCS#12 signing cert; generate a self-signed one with:
#   node backend/scripts/generate-esign-cert.js
# Unset = ceremonies complete without the signed-copy step.
ESIGN_P12_B64=
ESIGN_P12_PASSPHRASE=

# ── Object storage (MinIO) ───────────────────────────────────────────────────
MINIO_ROOT_USER=edams-storage
MINIO_ROOT_PASSWORD=

# ── Search ───────────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=

# ── Email (real relay — the boot guard refuses localhost) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EDAMS <noreply@examplecorp.com>

# ── Ops ──────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=
BACKUP_RETENTION_DAYS=14

# ── Platform licensing (docs/operations/PLATFORM-LICENSING.md) ───────────────
# Issued in SSO, checked by DMS from a signed token. Optional: with no licence record, or SSO unreachable and no
# token ever fetched, nothing is enforced. Enforcement: enforce (default) | warn (banner only) | off.
# LICENSE_SSO_URL is the SSO BACKEND base URL as seen from the API container (no path).
LICENSE_ENFORCEMENT=enforce
LICENSE_SSO_URL=
LICENSE_POLL_SECONDS=300
